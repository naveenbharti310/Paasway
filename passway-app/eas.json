{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://passway-api.vercel.app",
        "EXPO_PUBLIC_APP_CHECK": "off",
        "EXPO_PUBLIC_OTP_PROVIDER": "2factor",
        "EXPO_PUBLIC_SHOW_TEST_NUMBERS": "0"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://passway-api.vercel.app",
        "EXPO_PUBLIC_APP_CHECK": "off",
        "EXPO_PUBLIC_SHOW_TEST_NUMBERS": "0",
        "EXPO_PUBLIC_OTP_PROVIDER": "2factor"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_OTP_PROVIDER": "2factor",
        "EXPO_PUBLIC_SHOW_TEST_NUMBERS": "0",
        "EXPO_PUBLIC_API_URL": "https://passway-api.vercel.app"
      }
    },
    "play-attestation": {
      "extends": "production",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_CHECK": "on",
        "EXPO_PUBLIC_DIAGNOSTICS": "0",
        "EXPO_PUBLIC_SHOW_TEST_NUMBERS": "0"
      }
    },
    "play-testing": {
      "extends": "production",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_OTP_PROVIDER": "2factor",
        "EXPO_PUBLIC_API_URL": "https://passway-api.vercel.app",
        "EXPO_PUBLIC_APP_CHECK": "off",
        "EXPO_PUBLIC_SHOW_TEST_NUMBERS": "0"
      }
    },
    "play-diagnostics": {
      "extends": "play-testing",
      "env": {
        "EXPO_PUBLIC_DIAGNOSTICS": "1"
      }
    }
  },
  "submit": {
    "production": {},
    "play-attestation": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "play-testing": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
