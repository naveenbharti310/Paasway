{
  "name": "passway",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test:rules": "node --test test/firestore.rules.test.cjs",
    "test:rules:emulator": "npx --yes firebase-tools@15.32.1 emulators:exec --only firestore --project demo-passway \"npm run test:rules\"",
    "test:emulator": "npx --yes firebase-tools@15.32.1 emulators:exec --only auth,firestore --project demo-passway \"npm run test:rules && npm run test:integration --prefix functions && npm run test:auth:integration --prefix functions\"",
    "check": "npm run security:audit && npm run test:mobile && npm run typecheck && npm run typecheck --prefix functions && npm test --prefix functions && npm run test:emulator && expo export --platform all --output-dir dist",
    "preview:web": "sh scripts/web-preview.sh",
    "icons": "node scripts/make-icons.cjs",
    "postinstall": "node scripts/apply-security-fixes.cjs && node scripts/materialize-design-assets.cjs",
    "test:push-registration": "node --test test/push-registration.test.cjs",
    "test:startup-recovery": "node --test test/startup-recovery.test.cjs",
    "test:reliability": "node --test test/reliability.test.cjs",
    "test:mobile": "node --test test/connection-snapshots.test.cjs test/push-registration.test.cjs test/startup-recovery.test.cjs test/reliability.test.cjs test/chat-privacy.test.cjs test/account-deletion.test.cjs test/deployed-app-check.test.cjs test/android-data-protection.test.cjs test/connection-clock.test.cjs test/preview-config.test.cjs test/pairing-actions.test.cjs",
    "test:dependency-security": "node --test test/dependency-security.test.cjs test/security-remediation.test.cjs",
    "security:audit": "node scripts/security-audit.cjs",
    "security:conformance": "bash scripts/security-conformance.sh"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/app-check": "26.4.0",
    "@react-native-firebase/auth": "26.4.0",
    "@react-native-firebase/crashlytics": "26.4.0",
    "@react-native-firebase/firestore": "26.4.0",
    "@react-native-firebase/functions": "26.4.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "expo": "~57.0.29",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "~19.2.18",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "uuid": "^11.1.1"
  }
}
