{
  "name": "passway",
  "version": "0.1.0",
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test:rules": "node --test test/firestore.rules.test.cjs",
    "test:rules:emulator": "npx --yes firebase-tools@13.35.1 emulators:exec --only firestore --project demo-passway \"npm run test:rules\"",
    "test:emulator": "npx --yes firebase-tools@13.35.1 emulators:exec --only firestore --project demo-passway \"npm run test:rules && npm run test:integration --prefix functions\""
  },
  "dependencies": {
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.0",
    "expo": "~51.0.0",
    "expo-firebase-recaptcha": "^2.3.1",
    "expo-location": "~17.0.0",
    "expo-notifications": "~0.28.0",
    "expo-status-bar": "~1.12.0",
    "firebase": "^10.12.0",
    "react": "18.2.0",
    "react-native": "0.74.0",
    "react-native-safe-area-context": "4.10.0",
    "react-native-screens": "~3.31.0",
    "react-native-webview": "13.8.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "@types/react": "~18.2.0",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "react": "$react",
    "react-native": "$react-native"
  }
}
