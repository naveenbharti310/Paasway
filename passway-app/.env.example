# Firebase native settings come from google-services.json and
# GoogleService-Info.plist. Set these paths if the files live elsewhere.
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist

EXPO_PUBLIC_EAS_PROJECT_ID=

# Debug builds only. Register the same token under App Check in the Firebase console.
EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=

# Server for callables. Leave empty to use Cloud Functions.
EXPO_PUBLIC_API_URL=

# Set to off for builds installed outside Google Play or the App Store.
EXPO_PUBLIC_APP_CHECK=

# Build-time SMS provider. Supported: 2factor or firebase. Never put the API key here.
EXPO_PUBLIC_OTP_PROVIDER=2factor
