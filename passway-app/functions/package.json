{
  "name": "functions",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "private": true,
  "scripts": {
    "build": "tsc",
    "deploy": "firebase deploy --only functions",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.api.json",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:integration": "npm run build && node --test test/emulator.integration.cjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.11",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "ngeohash": "^0.6.4"
  },
  "devDependencies": {
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "jwks-rsa": "^3.2.2"
  }
}
